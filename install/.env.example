# TurtleShell.ai Off-Grid Node — Environment Configuration
# Version: 1.7.0 — CloudPremise LLC
# This file is pulled by the installer and used as a template.
# Your installer fills in the generated values automatically.
# You add your API keys after installation via the dashboard.

# ── NODE IDENTITY (generated by installer) ─────────────────
NODE_ID=
NODE_NAME=My TurtleShell Node
NODE_ENV=local
COSMOS_LOGOS_VERSION=1.0.3

# ── CONNECTION MODE ─────────────────────────────────────────
# local     = localhost only (default)
# tailscale = VPN mesh, configure after install
# ngrok     = public HTTPS tunnel, configure after install
CONNECTION_MODE=local

# ── NGROK (set CONNECTION_MODE=ngrok to activate) ──────────
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_TARGET_PORT=3451

# ── TAILSCALE (set CONNECTION_MODE=tailscale to activate) ──
TAILSCALE_AUTHKEY=

# ── SECURITY (generated by installer) ──────────────────────
JWT_SECRET=
COOKIE_SECRET=

# ── LLM PROVIDERS ──────────────────────────────────────────
# Add your API keys here. At least one required.
# Ollama runs locally — no key needed.
ATHENA_AI_TYPE=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434

# ── STORAGE ────────────────────────────────────────────────
PROTEUS_ADAPTER=localfile
PROTEUS_DATA_PATH=~/.turtleshell/data

# ── BILLING (optional — skip for personal use) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── INTEGRATIONS (connect via dashboard after install) ─────
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
HUBSPOT_CLIENT_ID=
