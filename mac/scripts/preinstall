#!/bin/bash
# preinstall — TurtleShell.ai Node Installer
# Runs before installation begins
# Exit non-zero to abort installation

set -e

echo "Checking system requirements..."

# macOS version check
OS_VERSION=$(sw_vers -productVersion | cut -d. -f1)
if [ "$OS_VERSION" -lt 13 ]; then
  echo "ERROR: TurtleShell.ai requires macOS 13 (Ventura) or later."
  echo "Your version: $(sw_vers -productVersion)"
  exit 1
fi

# RAM check (8GB minimum = 8589934592 bytes)
RAM=$(sysctl -n hw.memsize)
if [ "$RAM" -lt 8589934592 ]; then
  echo "ERROR: TurtleShell.ai requires 8GB RAM minimum."
  exit 1
fi

# Disk space check (20GB = 21474836480 bytes)
FREE_DISK=$(df -k ~ | tail -1 | awk '{print $4}')
FREE_BYTES=$((FREE_DISK * 1024))
if [ "$FREE_BYTES" -lt 21474836480 ]; then
  echo "ERROR: TurtleShell.ai requires 20GB free disk space."
  exit 1
fi

# Internet connectivity
if ! curl -fsSL --max-time 5 https://install.turtleshell.ai/health &>/dev/null; then
  echo "ERROR: No internet connection. Please connect and try again."
  exit 1
fi

echo "System requirements met."
exit 0
