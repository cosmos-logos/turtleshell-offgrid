<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">

  <title>TurtleShell.ai Sovereign Node</title>
  <organization>ai.turtleshell</organization>
  <domains enable_localSystem="true"/>
  <options customize="never"
           require-scripts="true"
           hostArchitectures="arm64,x86_64"/>

  <!-- Background -->
  <background file="background.png"
              alignment="bottomleft"
              scaling="proportional"
              mime-type="image/png"/>
  <background-darkAqua file="background.png"
                        alignment="bottomleft"
                        scaling="proportional"
                        mime-type="image/png"/>

  <!-- Screens -->
  <welcome file="welcome.html"
           mime-type="text/html"/>
  <license file="license.html"
           mime-type="text/html"/>
  <conclusion file="conclusion.html"
              mime-type="text/html"/>

  <!-- Package reference -->
  <pkg-ref id="ai.turtleshell.installer"/>

  <!-- Install choices -->
  <choices-outline>
    <line choice="default"/>
  </choices-outline>

  <choice id="default"
          visible="false"
          title="TurtleShell.ai Sovereign Node"
          description="Installs the complete TurtleShell.ai fleet.">
    <pkg-ref id="ai.turtleshell.installer"/>
  </choice>

  <pkg-ref id="ai.turtleshell.installer"
           version="1.7.0"
           onConclusion="none">TurtleShell-1.7.0-component.pkg</pkg-ref>

</installer-gui-script>
